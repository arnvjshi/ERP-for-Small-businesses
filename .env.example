# ─── Environment ─────────────────────────────────────────────────────
# "development" or "production"
ENVIRONMENT=development

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://laundrybros:laundrybros_dev_password@postgres:5432/laundrybros
POSTGRES_USER=laundrybros
POSTGRES_PASSWORD=laundrybros_dev_password
POSTGRES_DB=laundrybros

# ─── JWT ─────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production
JWT_SECRET=dev-secret-change-in-production-abc123xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Backend ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins, or * for all (dev only)
CORS_ORIGINS=*

# Optional: prefix all API routes (e.g., /v1)
# Leave empty for default /api/* routes
API_PREFIX=

# ─── Gunicorn (production only) ──────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# ─── Frontend ────────────────────────────────────────────────────────
# The URL the frontend uses to call the backend API.
# For local dev:        http://localhost:8000
# For Docker dev:       http://localhost:8000
# For Docker prod:      https://yourdomain.com (nginx proxies /api/* to backend)
# For Vercel:           leave empty or unset (same-origin via Vercel Services)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Laundry Bros

# ─── Nginx (production only) ─────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
